# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary build output with the embedded frontend
/elenxa
/elenxa.exe
# Intermediate files the one-click updater leaves next to the executable (staged copy / backup / failed version / upgrade marker)
/elenxa.new
/elenxa.new.sha256
/elenxa.old
/elenxa.failed
/elenxa.upgrade.json
/server/webui/dist/
/dist/

# Generated Go dependency tree. Docker builds require it locally, but the
# canonical dependency inputs are go.mod, go.sum, and third_party/norma.
/vendor/

# Local Go test and coverage output
*.test
/coverage.out
/coverage.html

# JWT signing key (generated at runtime, stored in the project root, never commit)
/jwt.key

# Local environment generated by the Docker deployment (contains passwords/keys, do not commit)
.env

# Event logs produced by scheduler runs/simulations (test output, do not commit)
*-events.csv

# bench benchmark related (local output, do not commit)
/bench/
/benchmark/results/
/Dockerfile.bench
/Dockerfile.bench.v2
# hardened local build
/.env
# web/.env only disables Next.js telemetry; committed on purpose
!/web/.env
/elenxa-browser-mcp
/setup-token
web/out/

# Local research, reports, and decision logs
/reports/
/research_notes/
/.audit/
