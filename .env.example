# Copy to .env (install.sh generates one for you with a random password).
# The elenxa image is always built locally (docker compose build); there is no tag to pull.
POSTGRES_USER=elenxa
# Required. Use a long random value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
POSTGRES_DB=elenxa

# LLM (or leave empty and configure in the UI). Anthropic API is the only intended provider.
ANTHROPIC_API_KEY=
ELENXA_LLM_PROVIDER=
ELENXA_LLM_MODEL=
ELENXA_LLM_BASE_URL=
ELENXA_LLM_PROXY=

# Extra Host headers the UI/API accept besides localhost/127.0.0.1/::1 (comma-separated).
ELENXA_ALLOWED_HOSTS=
# DNS resolvers for enrichment as ip:port, comma-separated (default: /etc/resolv.conf).
ELENXA_DNS_RESOLVERS=
